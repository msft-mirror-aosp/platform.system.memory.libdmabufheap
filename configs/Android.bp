package {
    default_team: "trendy_team_android_kernel",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libdma_heap_config_proto",
    host_supported: true,
    srcs: [
        "schema.proto",
    ],
    proto: {
        type: "full",
        export_proto_headers: true,
    },
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}

// Tests that the config files follow the schema.
cc_test {
    name: "vts_dma_heap_config_test",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    srcs: [
        "test.cpp",
    ],
    static_libs: [
        "libdma_heap_config_proto",
        "libjsoncpp",
        "libjsonpbverify",
    ],
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "liblog",
        "libprotobuf-cpp-full",
        "libutils",
        "packagemanager_aidl-cpp",
    ],
    test_suites: [
        "vts",
        "general-tests",
    ],
    require_root: true,
}
